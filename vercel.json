{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "crons": [
    {
      "path": "/api/demo/restore",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/warranties/expire",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/deliveries/expire",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/vendor-subscription/expire",
      "schedule": "15 19 * * *"
    },
    {
      "path": "/api/promotions/expire",
      "schedule": "30 19 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
